{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.psdc.example/workspace/repos.schema.json",
  "type": "object",
  "required": ["schemaVersion", "workspace", "repositories", "defaults", "governance"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "workspace": { "type": "string", "minLength": 1 },
    "workspaceRemote": { "type": "string", "format": "uri" },
    "repositoryPolicy": { "type": "string" },
    "gitAuthorName": { "type": "string" },
    "gitAuthorEmail": { "type": "string", "format": "email" },
    "githubOrganizations": {
      "type": "object",
      "required": ["common", "algonquin"],
      "properties": {
        "common": { "type": "string", "minLength": 1 },
        "algonquin": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "externalInterfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "boundary"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "boundary": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["repository", "dependencies", "interfaces", "institutionOverlays", "evidence"],
        "properties": {
          "repository": {
            "type": "object",
            "required": ["id", "owner", "path", "remote", "role", "authority", "lifecycle", "upstream"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
              "owner": { "type": "string" },
              "path": { "type": "string" },
              "remote": { "type": "string", "format": "uri" },
              "role": { "type": "string" },
              "authority": { "enum": ["common", "institution"] },
              "lifecycle": { "enum": ["proposal", "specification", "implementation", "deployment", "production", "deprecated"] },
              "upstream": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          },
          "dependencies": { "$ref": "#/$defs/dependencies" },
          "interfaces": { "$ref": "#/$defs/interfaces" },
          "institutionOverlays": { "type": "array", "items": { "$ref": "#/$defs/overlay" } },
          "evidence": { "$ref": "#/$defs/evidence" }
        },
        "additionalProperties": false
      }
    },
    "defaults": { "type": "object" },
    "governance": { "type": "object" }
  },
  "$defs": {
    "dependencies": {
      "type": "object",
      "required": ["required", "optional"],
      "properties": {
        "required": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "optional": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "interfaces": {
      "type": "object",
      "required": ["provides", "consumes"],
      "properties": {
        "provides": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "consumes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "overlay": {
      "type": "object",
      "required": ["id", "owner", "path", "remote"],
      "properties": {
        "id": { "type": "string" }, "owner": { "type": "string" },
        "path": { "type": "string" }, "remote": { "type": "string", "format": "uri" },
        "status": { "enum": ["active", "planned", "deprecated"] }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["documentation", "contracts", "implementation", "deployment"],
      "properties": {
        "documentation": { "enum": ["absent", "partial", "present"] },
        "contracts": { "enum": ["absent", "partial", "present"] },
        "implementation": { "enum": ["absent", "partial", "present"] },
        "deployment": { "enum": ["absent", "partial", "present"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
